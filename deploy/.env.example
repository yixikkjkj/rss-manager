# rss-manager 环境变量模板（交付物 D-04）
# 复制为 .env 后按需修改；Docker 由 docker-compose env_file 注入，二进制由守护 unit Environment= 注入。

# ===== L3 配置（有默认值）=====

# 应用监听地址
# 二进制部署（Caddy 同机）：127.0.0.1:8080
# Docker 部署：由 docker-compose 强制覆盖为 0.0.0.0:8080（容器内监听，仅内部网络可达）
RSS_MANAGER_LISTEN_ADDR=127.0.0.1:8080

# SQLite 数据文件路径
RSS_MANAGER_DB_PATH=/data/rss_manager.db

# 备份目录（与数据文件物理隔离）
RSS_MANAGER_BACKUP_DIR=/data/backups

# 日志级别（TRACE/DEBUG/INFO/WARN/ERROR）
RSS_MANAGER_LOG_LEVEL=INFO

# 全局默认抓取间隔（秒，默认 3600 即 60min；单源下限 ≥ 1800 即 30min）
RSS_MANAGER_FETCH_INTERVAL=3600

# ===== L4 Secret（无默认，必须显式提供）=====

# 会话签名密钥（256bit 随机）
# 生成：openssl rand -hex 32
RSS_MANAGER_SESSION_SECRET=

# 初始密码 argon2id 哈希（仅首次启动 t_user 为空时必需）
# 生成：./rss-manager hash-password '你的初始密码'
RSS_MANAGER_INITIAL_PASSWORD_HASH=
