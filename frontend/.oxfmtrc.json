{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 110,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "package-lock.json",
    "playwright-report",
    "test-results",
    "pnpm-lock.yaml"
  ]
}
